@using CSCPA.Model
@Html.AntiForgeryToken()

@(Html.DevExtreme().Form<LRPVendorReportAddEditModel>
    ().ID("LRPVendorReportAddEditDevForm")
    .ColCount(2)
    .Items(groupItems =>
    {
        groupItems.AddSimpleFor(m => m.ObjectUID).Visible(false);

        groupItems.AddSimpleFor(m => m.AddressI_Reporting).IsRequired(true);
        groupItems.AddEmpty();

        groupItems.AddSimpleFor(m => m.AddressII_Reporting).IsRequired(true);
        groupItems.AddSimpleFor(m => m.AddressIII_Reporting);


        groupItems.AddSimpleFor(m => m.Userdef1_Reporting);
        groupItems.AddEmpty();

        groupItems.AddSimpleFor(m => m.Userdef2_Reporting);
        groupItems.AddEmpty();

        groupItems.AddSimpleFor(m => m.City_Reporting);
        groupItems.AddSimpleFor(m => m.PostalCode_Reporting).Label(l => l.Text("Postal Code"));


        groupItems.AddSimpleFor(m => m.CountryID).Label(l => l.Text("Country"))
        .Editor(e => e
        .SelectBox()
        .ID("Country")
        .DataSource(d => d.Mvc().Controller("Country").LoadAction("LookUp").Key("Value"))
        .DisplayExpr("Text")
        .ValueExpr("Value")
        .OnValueChanged("lrpVendorReportAddEdit.onchangeCountry")
        );

        groupItems.AddSimpleFor(m => m.Country_StateID).Label(l => l.Text("Country State"))
        .Editor(e => e
        .SelectBox()
        .ID("State")
        .DataSource(d => d.Mvc().Controller("CountryState").LoadAction("Lookup").Key("ObjectUID"))
        .DisplayExpr("Name")
        .ValueExpr("ObjectUID")
        );

        groupItems.AddSimpleFor(m => m.Description)
        .ColSpan(2)
        .Editor(e => e
        .TextArea()
        .Height(140)
        );

        groupItems.AddButton()
        .HorizontalAlignment(HorizontalAlignment.Left)
        .ButtonOptions(b => b.Text("Save")
        .Type(ButtonType.Success)
        .UseSubmitBehavior(false)
        .OnClick("lrpVendorReportAddEdit.save")
        );
    })
    .FormData(Model)
    )
